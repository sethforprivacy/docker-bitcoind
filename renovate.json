{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "mergeConfidence:all-badges",
    ":disableRateLimiting",
    ":semanticCommits"
  ],
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\sARG VERSION=(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{extractVersion}}{{else}}^v(?<version>.+)${{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Bitcoin Core upstream tags are prefixed with 'v' but the Dockerfile ARG omits it; strip the prefix so Renovate proposes e.g. 31.0 (no 'v').",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "bitcoin/bitcoin"
      ],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Batch and auto-merge low-risk GitHub Actions and Docker updates once checks pass",
      "matchManagers": [
        "github-actions",
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "patch",
        "minor",
        "pin"
      ],
      "groupName": "low-risk dependency updates",
      "automerge": true
    }
  ],
  "automergeType": "pr"
}
